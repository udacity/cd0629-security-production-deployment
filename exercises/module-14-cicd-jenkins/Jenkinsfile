// Udabank orderservice — build, test, scan, deploy to staging.
//
// Stages: build and test -> security scan -> (main branch only) build the
// image and load it into the cluster -> manual approval -> deploy.
//
// Run this as a Multibranch Pipeline job. `when { branch 'main' }` only
// means something there; a plain Pipeline job has no notion of which
// branch a build is for.
//
// Setup (see README.md for details):
//   - Jenkins credential: `nvd-api-key` (Secret text), used by the
//     Security Scan stage.
//   - A kubeconfig at /var/jenkins_home/.kube-config (see KUBECONFIG below).
//   - `docker`, `mvn`, `kubectl`, and a matching JDK installed wherever
//     the pipeline's shell steps run.
//   - Jenkins plugins: Pipeline, Docker Pipeline, OWASP Dependency-Check,
//     Workspace Cleanup, Timestamper, and JUnit.

pipeline {
    agent any

    options {
        timestamps()
        disableConcurrentBuilds()
        buildDiscarder(logRotator(numToKeepStr: '20'))
    }

    environment {
        IMAGE_NAME  = 'udabank/orderservice'
        GIT_SHA     = "${env.GIT_COMMIT ? env.GIT_COMMIT.take(7) : 'local'}"
        IMAGE_TAG   = "${IMAGE_NAME}:${GIT_SHA}"
        // Kubeconfig that kubectl uses to reach the staging cluster.
        KUBECONFIG  = '/var/jenkins_home/.kube-config'
        // The Dockerfile uses `RUN --mount=type=cache`, which needs
        // BuildKit (and the `buildx` plugin) to build.
        DOCKER_BUILDKIT = '1'
    }

    stages {

        stage('Build and Test') {
            steps {
                dir('orderservice') {
                    sh 'mvn -B clean verify'
                }
            }
            post {
                always {
                    junit testResults: 'orderservice/target/surefire-reports/*.xml', allowEmptyResults: true
                }
            }
        }

        stage('Security Scan') {
            steps {
                dir('orderservice') {
                    withCredentials([string(credentialsId: 'nvd-api-key', variable: 'NVD_API_KEY')]) {
                        sh 'mvn org.owasp:dependency-check-maven:check -DnvdApiKey=$NVD_API_KEY -DfailBuildOnCVSS=8'
                    }
                }
            }
            post {
                always {
                    dependencyCheckPublisher pattern: 'orderservice/target/dependency-check-report.xml'
                }
            }
        }

        stage('Docker Build and Load') {
            when {
                branch 'main'
            }
            steps {
                dir('orderservice') {
                    sh '''
                        docker build -t "$IMAGE_TAG" .
                        docker save "$IMAGE_TAG" | docker exec -i minikube docker load
                    '''
                }
            }
        }

        stage('Approve Deploy to Staging') {
            when {
                branch 'main'
            }
            steps {
                input message: "Deploy ${GIT_SHA} to staging?", ok: 'Deploy'
            }
        }

        stage('Deploy to Staging') {
            when {
                branch 'main'
            }
            steps {
                sh '''
                    kubectl apply -f k8s/orderservice-secret.yaml
                    kubectl apply -f k8s/orderservice-configmap.yaml
                    kubectl apply -f k8s/postgres.yaml
                    kubectl apply -f k8s/redis.yaml
                    kubectl apply -f k8s/inventoryservice-deployment.yaml
                    kubectl apply -f k8s/orderservice-deployment.yaml
                    kubectl apply -f k8s/orderservice-service.yaml
                    kubectl set image deployment/orderservice orderservice="$IMAGE_TAG"
                    kubectl rollout status deployment/orderservice --timeout=120s
                '''
            }
        }
    }

    post {
        failure {
            // Console message standing in for a Slack or email notification.
            echo "NOTIFY: orderservice pipeline FAILED on ${env.BRANCH_NAME} (${GIT_SHA}): ${env.BUILD_URL}"
        }
        always {
            cleanWs()
        }
    }
}
