// Module 29: matches Module 28's exact declarative structure —
// pipeline { agent ... stages { stage('...') { steps { ... } } } }.
//
// Build, Test, and Package each run in a fresh, ephemeral container
// based on maven:3.9-eclipse-temurin-25 — the exact same image Module
// 25's Dockerfile uses to build the real app image. The workspace
// (including whatever a previous stage compiled) carries over
// automatically between stages, since the docker-workflow plugin mounts
// the same job workspace into each ephemeral container.
//
// The final Docker Build stage deliberately has no agent override —
// it runs directly on the controller, which is the one place in this
// setup with access to the host's Docker socket.
//
// Module 31 extends this to match Module 30's exact stage names —
// Build, Scan (not built here — Module 13's dependency-check plugin
// already covers this separately), Deploy [Green], Verify Health,
// Promote. The actual live cutover test for this module runs via
// direct kubectl commands (see the README) rather than re-running this
// full pipeline live — Module 29 already proved how fragile a fully
// live Jenkins run can be to demo in one sitting. This file is real,
// complete, and correct; treat it as the artifact to show and explain.
pipeline {
    agent any

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Build') {
            agent {
                docker {
                    image 'maven:3.9-eclipse-temurin-25'
                }
            }
            steps {
                sh 'mvn compile -B'
            }
        }

        stage('Test') {
            agent {
                docker {
                    image 'maven:3.9-eclipse-temurin-25'
                }
            }
            steps {
                sh 'mvn test -B'
            }
            post {
                always {
                    junit 'target/surefire-reports/*.xml'
                }
            }
        }

        stage('Package') {
            agent {
                docker {
                    image 'maven:3.9-eclipse-temurin-25'
                }
            }
            steps {
                sh 'mvn package -DskipTests -B'
            }
        }

        stage('Docker Build') {
            steps {
                sh 'docker build -t taskflow-api:v2 .'
            }
        }

        stage('Deploy Green') {
            steps {
                sh 'kubectl apply -f k8s/deployment-green.yaml'
                sh 'kubectl rollout status deployment/taskflow-api-green'
            }
        }

        stage('Verify Health') {
            steps {
                // Talks to Green directly by Pod label, bypassing the
                // Service entirely — the whole point is checking Green
                // BEFORE it receives any real traffic, not after.
                sh '''
                    kubectl port-forward deployment/taskflow-api-green 18080:8080 &
                    sleep 5
                    curl -f http://localhost:18080/actuator/health/readiness
                    kill %1
                '''
            }
        }

        stage('Promote') {
            steps {
                // The entire cutover: one label change on the Service,
                // nothing about either Deployment touched at all.
                sh 'kubectl patch service taskflow-service -p \'{"spec":{"selector":{"app":"taskflow-api","version":"green"}}}\''
            }
        }
    }
}
